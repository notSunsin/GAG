-- Masukkan 1 tool buah ke dalam trade offer secara langsung
local function AddFruitToTrade(tool, uuid)
    if not tool then return false end
    uuid = uuid or GetItemUUID(tool)
    if not uuid then return false end

    -- Tentukan ItemType ("Holdable" adalah default buah di GAG)
    local itemTypeAttr = tool:GetAttribute("b") or tool:GetAttribute("ITEM_TYPE")
    local itemType = "Holdable"
    if itemTypeAttr and ReversedItemTypeEnums and ReversedItemTypeEnums[itemTypeAttr] then
        itemType = ReversedItemTypeEnums[itemTypeAttr]
    end

    local sent = false

    -- 1. Direct Remote Call ke AddItem (paling handal & tidak terblokir upvalue u20 controller)
    if AddItemRemote then
        local ok, _ = pcall(function()
            AddItemRemote:FireServer(itemType, uuid)
        end)
        if ok then sent = true end
    end

    -- 2. Controller AddItem Fallback
    if not sent and TradingController and TradingController.AddItem then
        local ok, _ = pcall(function()
            TradingController:AddItem(itemType, uuid)
        end)
        if ok then sent = true end
    end

    -- 3. Controller AddFromTool Fallback
    pcall(function()
        if TradingController and TradingController.AddFromTool then
            TradingController:AddFromTool(tool)
        end
    end)

    return sent
end

-- Worker Sesi Trade Aktif (Koordinator Pengirim & Penerima)
local function HandleActiveTradeSession(tradeReplicator)
    if State.IsWorkerRunning then return end
    State.IsWorkerRunning = true

    task.spawn(function()
        task.wait(0.3) -- Jeda inisialisasi trade state

        local dataAsync = nil
        pcall(function()
            if tradeReplicator and tradeReplicator.GetDataAsync then
                dataAsync = tradeReplicator:GetDataAsync(5)
            elseif TradingController and TradingController.CurrentTradeReplicator then
                dataAsync = TradingController.CurrentTradeReplicator:GetDataAsync(5)
            end
        end)

        if not dataAsync or not dataAsync.players then
            State.IsWorkerRunning = false
            return
        end

        local myIdx = table.find(dataAsync.players, LocalPlayer)
        if not myIdx then
            State.IsWorkerRunning = false
            return
        end

        local partnerIdx = (myIdx == 1) and 2 or 1
        local partnerPlayer = dataAsync.players[partnerIdx]
        State.PartnerPlayer = partnerPlayer
        local partnerName = partnerPlayer and partnerPlayer.Name or "Partner"

        AppendLog(string.format("[TRADE AKTIF] Bersama @%s!", partnerName), Color3.fromRGB(100, 255, 180))
        UpdateStatusUI(string.format("Trade Aktif: @%s", partnerName))

        -- 1. JIKA MODE PENGIRIM (SENDER): OTOMATIS MASUKKAN BUAH TERPILIH
        local itemsAddedThisSession = 0
        if Config.AutoGift then
            AppendLog("[AUTO INSERT] Memeriksa & memasukkan buah sesuai filter...", Color3.fromRGB(255, 230, 100))
            UpdateStatusUI("Memasukkan buah ke offer...")

            -- Minta TradingController membuka status trading
            pcall(function()
                if TradingController and TradingController.RequestAddItem then
                    TradingController:RequestAddItem()
                end
            end)
            task.wait(0.15)

            local allFruits = ScanBackpackFruits()
            local itemLimit = (TradeData and TradeData.ItemLimit) or 12
            local currentOffers = (dataAsync.offers and dataAsync.offers[myIdx] and dataAsync.offers[myIdx].items) or {}
            local currentCount = #currentOffers

            for _, fruitInfo in ipairs(allFruits) do
                if currentCount >= itemLimit then break end

                if IsFruitEligible(fruitInfo) then
                    local ok = AddFruitToTrade(fruitInfo.Tool, fruitInfo.UUID)
                    if ok then
                        itemsAddedThisSession = itemsAddedThisSession + 1
                        currentCount = currentCount + 1
                        AppendLog(string.format("[INSERT] + %s (%d/12)", fruitInfo.CleanName, currentCount), Color3.fromRGB(120, 255, 140))
                        task.wait(Config.AddFruitDelay)
                    end
                end
            end

            AppendLog(string.format("[AUTO INSERT] Berhasil memasukkan %d buah (%d/12 di offer).", itemsAddedThisSession, currentCount), Color3.fromRGB(120, 255, 140))
        end

        -- 2. OTOMASI ACCEPT & CONFIRM DUA ARAH (SENDER & RECEIVER)
        while State.IsTradeActive do
            local currentData = nil
            pcall(function()
                if tradeReplicator and tradeReplicator.GetDataAsync then
                    currentData = tradeReplicator:GetDataAsync(2)
                elseif TradingController and TradingController.CurrentTradeReplicator then
                    currentData = TradingController.CurrentTradeReplicator:GetDataAsync(2)
                end
            end)

            if not currentData then break end

            local sNow = workspace:GetServerTimeNow()
            local elapsed = sNow - (currentData.lastChange or sNow)
            local myState = currentData.states and currentData.states[myIdx] or "None"
            local partnerState = currentData.states and currentData.states[partnerIdx] or "None"

            local myOfferItems = (currentData.offers and currentData.offers[myIdx] and currentData.offers[myIdx].items) or {}
            local partnerOfferItems = (currentData.offers and currentData.offers[partnerIdx] and currentData.offers[partnerIdx].items) or {}

            -- Evaluasi Kesiapan Accept:
            -- A. Pengirim (Sender): Siap jika offer terisi (12 penuh atau stok buah cocok habis)
            local isSenderReady = Config.AutoGift and (#myOfferItems >= 12 or itemsAddedThisSession > 0 or #myOfferItems > 0)

            -- B. Penerima (Receiver): Siap jika checkbox Auto Acc Trade aktif dan partner sudah offer / accept
            local isReceiverReady = Config.AutoAccTrade and (#partnerOfferItems > 0 or partnerState == "Accepted" or partnerState == "Confirmed")

            local shouldAccept = isSenderReady or isReceiverReady
            local waitRemain = math.max(0, Config.ButtonCooldownWait - elapsed)

            if myState == "None" then
                if shouldAccept then
                    if waitRemain > 0 then
                        UpdateStatusUI(string.format("Cooldown Accept (%.1fs)...", waitRemain))
                        task.wait(math.min(0.3, waitRemain))
                    else
                        AppendLog("[ACCEPT] Mengirim persetujuan trade...", Color3.fromRGB(130, 220, 255))
                        UpdateStatusUI("Mengirim Accept...")
                        pcall(function()
                            if TradingController and TradingController.Accept then
                                TradingController:Accept()
                            elseif AcceptRemote then
                                AcceptRemote:FireServer()
                            end
                        end)
                        task.wait(0.4)
                    end
                else
                    task.wait(0.3)
                end
            elseif myState == "Accepted" then
                if partnerState ~= "Accepted" and partnerState ~= "Confirmed" then
                    UpdateStatusUI("Menunggu Partner Accept...")
                    task.wait(0.3)
                else
                    if waitRemain > 0 then
                        UpdateStatusUI(string.format("Cooldown Confirm (%.1fs)...", waitRemain))
                        task.wait(math.min(0.3, waitRemain))
                    else
                        AppendLog("[CONFIRM] Kedua pihak Accept! Menekan Confirm...", Color3.fromRGB(100, 255, 140))
                        UpdateStatusUI("Mengirim Confirm...")
                        pcall(function()
                            if TradingController and TradingController.Confirm then
                                TradingController:Confirm()
                            elseif ConfirmRemote then
                                ConfirmRemote:FireServer()
                            end
                        end)
                        task.wait(0.5)
                    end
                end
            elseif myState == "Confirmed" then
                AppendLog("[TRADE SUKSES] Transaksi trade berhasil diselesaikan!", Color3.fromRGB(100, 255, 160))
                UpdateStatusUI("Trade Selesai!")
                if itemsAddedThisSession > 0 then
                    State.TotalGiftedCount = State.TotalGiftedCount + itemsAddedThisSession
                end
                break
            end

            task.wait(0.25)
        end

        State.IsWorkerRunning = false
        UpdateStatusUI(Config.AutoGift and "Menunggu sesi berikutnya..." or "Idle")
    end)
end

