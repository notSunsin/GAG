local function ToggleAutoAcc()
    Config.AutoAccTrade = not Config.AutoAccTrade
    local active = Config.AutoAccTrade
    AutoAccBox.Text = active and "X" or ""
    AutoAccBox.BackgroundColor3 = active and Color3.fromRGB(0, 200, 130) or Color3.fromRGB(36, 42, 58)
    if active then
        AppendLog("[PENERIMA] Auto Acc Trade DIAKTIFKAN. Menunggu trade masuk...", Color3.fromRGB(100, 255, 140))
        UpdateStatusUI("Receiver Aktif (Auto Acc)")
    else
        AppendLog("[PENERIMA] Auto Acc Trade DINONAKTIFKAN.", Color3.fromRGB(255, 160, 160))
        UpdateStatusUI("Idle")
    end
end

