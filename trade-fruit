-- Cari item Trading Ticket di Backpack / Karakter
local function GetTradingTicketTool()
    local containers = { LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack") }
    for _, cont in ipairs(containers) do
        if cont then
            for _, item in ipairs(cont:GetChildren()) do
                if item:IsA("Tool") then
                    local s = string.lower(item.Name)
                    if string.find(s, "trading ticket", 1, true)
                        or string.find(s, "trade ticket", 1, true)
                        or string.find(s, "ticket", 1, true) then
                        return item
                    end
                end
            end
        end
    end
    return nil
end

-- Pegang Trading Ticket di tangan
local function HoldTradingTicket()
    local tool = GetTradingTicketTool()
    if not tool then
        State.HasTradingTicket = false
        return false, "Trading Ticket tidak ditemukan di Backpack atau Karakter!"
    end

    State.HasTradingTicket = true
    if tool.Parent == LocalPlayer.Character then
        return true, "Trading Ticket sudah dipegang."
    end

    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:UnequipTools()
        task.wait(0.08)
        humanoid:EquipTool(tool)
        task.wait(0.12)
        return true, "Berhasil memegang Trading Ticket."
    else
        tool.Parent = LocalPlayer.Character
        task.wait(0.1)
        return true, "Berhasil memegang Trading Ticket."
    end
end

-- Temukan player target berdasarkan input nama (Aman dari capability restriction)
local function FindPlayerByName(query)
    if not query or query == "" then return nil end
    local clean = string.lower(string.gsub(query, "^@", ""))

    local allPlayers = {}
    pcall(function()
        allPlayers = Players:GetPlayers()
    end)

    -- Match exact Name / DisplayName
    for _, plr in ipairs(allPlayers) do
        local pName, pDisp = "", ""
        pcall(function()
            pName = plr.Name
            pDisp = plr.DisplayName
        end)
        if plr ~= LocalPlayer and pName ~= "" then
            if string.lower(pName) == clean or string.lower(pDisp) == clean then
                return plr
            end
        end
    end

    -- Match substring
    for _, plr in ipairs(allPlayers) do
        local pName, pDisp = "", ""
        pcall(function()
            pName = plr.Name
            pDisp = plr.DisplayName
        end)
        if plr ~= LocalPlayer and pName ~= "" then
            if string.find(string.lower(pName), clean, 1, true) or string.find(string.lower(pDisp), clean, 1, true) then
                return plr
            end
        end
    end

    return nil
end

-- Posisi berdiri dekat target player
local function StandNearPlayer(targetPlr)
    if not targetPlr then return false end
    local myChar = LocalPlayer.Character
    local tChar = targetPlr.Character
    if not myChar or not tChar then return false end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart
    local tRoot = tChar:FindFirstChild("HumanoidRootPart") or tChar.PrimaryPart
    if not myRoot or not tRoot then return false end

    local dist = (myRoot.Position - tRoot.Position).Magnitude
    if dist > 4.5 then
        local lookVec = tRoot.CFrame.LookVector
        local targetPos = tRoot.Position + (lookVec * 3.0)
        myRoot.CFrame = CFrame.new(targetPos, tRoot.Position)
        task.wait(0.12)
    end
    return true
end

