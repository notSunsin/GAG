    else
        for idx, fruitName in ipairs(fruits) do
            local stock = State.BagFruitCounts[fruitName] or 0
            local isChecked = Config.SelectAllFruits or (Config.SelectedFruits[fruitName] == true)

            local row = Instance.new("Frame")
