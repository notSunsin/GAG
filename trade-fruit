-- Ambil UUID tool secara lengkap
local function GetItemUUID(tool)
    if not tool then return nil end
    local uuid = tool:GetAttribute("c")
        or tool:GetAttribute("ITEM_UUID")
        or tool:GetAttribute("UUID")
        or (InventoryServiceEnums and tool:GetAttribute(InventoryServiceEnums.ITEM_UUID))
        or tool:GetAttribute("PET_UUID")
    return uuid
end

-- Ekstrak nama buah dasar tanpa mutasi dan berat
local function ExtractCleanFruitName(rawName)
    local s = tostring(rawName or "")
    s = s:gsub("%b[]", "") -- Buang tag bracket [Hieroglyphic], [10.5kg]
    s = s:gsub("%b()", "")

    for _, m in ipairs(KNOWN_MUTATIONS) do
        s = s:gsub(m, "")
    end

    s = s:gsub("[%d%.]+%s*kg", "") -- Buang berat seperti 15.2kg
    s = s:gsub("^%s+", ""):gsub("%s+$", "") -- Trim

    if s == "" then
        s = rawName
    end
    return s
end

-- Deteksi apakah tool adalah item buah panen (bukan gear/ticket/pet/seed)
local function IsFruitTool(tool)
    if not (tool and tool:IsA("Tool")) then return false end

    -- Abaikan jika Pet
    if tool:GetAttribute("PET_UUID") or tool:GetAttribute("PetUUID") or tool:HasTag("PetTool") then
        return false
    end

    local rawName = tool.Name
    local lowerName = string.lower(rawName)

    -- 2. Blacklist spesifik item yang bukan buah / tidak dapat di-gift (makanan olahan, gear, event item)
    local blacklist = {
        -- Non-fruit / untradeable items:
        "bonfire", "cake", "fairy targeter", "targeter", "hotdog", "smoothie",
        "star caller", "star caler", "yule log",

        -- Alat, Ticket, Benih, Gear, Crate, Potion:
        "trading ticket", "trade ticket", "ticket", "watering", "can", "sprinkler",
        "shears", "shovel", "radar", "staff", "fertilizer", "potion", "rod", "egg",
        "seed", "crate", "trowel", "basket", "backpack", "blower", "net", "jar",
        "lantern", "flute", "whistle", "totem", "scroll", "compass", "wrench", "pouch",
        "caller", "wand", "kite", "extender", "summoner",

        -- Makanan olahan / Masakan (Food / Non-fruit dishes):
        "burger", "soup", "sandwich", "pie", "cookie", "bread", "pizza", "salad",
        "dish", "meal", "coffee", "tea", "candy", "chocolate", "stew", "pancake", "waffle"
    }
    for _, word in ipairs(blacklist) do
        if string.find(lowerName, word, 1, true) then
            return false
        end
    end

    -- 3. Cek apakah bertipe Food ("u") dari Enum ItemType (makanan olahan tidak dapat di-gift sebagai buah)
    local itemTypeAttr = tool:GetAttribute("b") or tool:GetAttribute("ITEM_TYPE")
    if itemTypeAttr == "u" or itemTypeAttr == "Food" then
        return false
    end

    -- 4. Indikator Pasti Buah Hasil Panen di GAG:
    -- A. Cek FruitVersion attribute ("s") - ciri khas utama buah panen GAG
    if tool:GetAttribute("s") or tool:GetAttribute("FruitVersion") then
        local nameAttr = tool:GetAttribute("f") or tool:GetAttribute("ItemName") or rawName
        return true, tostring(nameAttr)
    end

    -- B. Cek Item_String (ciri khas panen tanaman GAG)
    local itemStr = tool:FindFirstChild("Item_String")
    if itemStr and itemStr.Value and itemStr.Value ~= "" then
        local val = tostring(itemStr.Value)
        for _, word in ipairs(blacklist) do
            if string.find(string.lower(val), word, 1, true) then
                return false
            end
        end
        return true, val
    end

    -- C. Cek PlantType / FruitType
    local pType = tool:GetAttribute("PlantType") or tool:GetAttribute("FruitType")
    if pType and type(pType) == "string" and pType ~= "" then
        for _, word in ipairs(blacklist) do
            if string.find(string.lower(pType), word, 1, true) then
                return false
            end
        end
        return true, pType
    end

    -- D. Cek dengan SeedData resmi game (harus terdaftar di data benih/tanaman)
    local cleanName = ExtractCleanFruitName(rawName)
    if SeedData and (SeedData[cleanName] or SeedData[rawName]) then
        return true, cleanName
    end

    -- E. Cek atribut Berat buah (Weight / FruitWeight)
    if tool:GetAttribute("Weight") or tool:GetAttribute("FruitWeight") or tool:GetAttribute("BaseWeight") then
        local nameAttr = tool:GetAttribute("f") or tool:GetAttribute("ItemName") or cleanName
        return true, tostring(nameAttr)
    end

    return false, rawName
end

-- Ekstrak daftar mutasi pada suatu tool buah
local function ExtractFruitMutations(tool)
    local muts = {}
    local rawName = tool.Name
    local lowerName = string.lower(rawName)

    -- 1. Cek dari nama tool
    for _, m in ipairs(KNOWN_MUTATIONS) do
        if string.find(lowerName, string.lower(m), 1, true) then
            if not table.find(muts, m) then table.insert(muts, m) end
        end
    end

    -- 2. Cek Attributes
    for attr, val in pairs(tool:GetAttributes()) do
        local lAttr = string.lower(tostring(attr))
        for _, m in ipairs(KNOWN_MUTATIONS) do
            if lAttr == string.lower(m) and (val == true or val == 1 or type(val) == "string") then
                if not table.find(muts, m) then table.insert(muts, m) end
            end
        end
        if type(val) == "string" then
            local lVal = string.lower(val)
            for _, m in ipairs(KNOWN_MUTATIONS) do
                if string.find(lVal, string.lower(m), 1, true) then
                    if not table.find(muts, m) then table.insert(muts, m) end
                end
            end
        end
    end

    -- 3. Cek Tag CollectionService
    for _, tag in ipairs(CollectionService:GetTags(tool)) do
        local lTag = string.lower(tag)
        for _, m in ipairs(KNOWN_MUTATIONS) do
            if lTag == string.lower(m) then
                if not table.find(muts, m) then table.insert(muts, m) end
            end
        end
    end

    -- 4. Cek Modul MutationHandler jika ada
    if MutationHandler and MutationHandler.GetPlantMutations then
        pcall(function()
            local list = MutationHandler:GetPlantMutations(tool, true)
            if type(list) == "table" then
                for _, mName in ipairs(list) do
                    if not table.find(muts, tostring(mName)) then
                        table.insert(muts, tostring(mName))
                    end
                end
            end
        end)
    end

    local isNormal = (#muts == 0)
    return muts, isNormal
end

-- Pindai seluruh buah di ransel player
ScanBackpackFruits = function()
    local fruits = {}
    local discovered = {}
    local counts = {}

    local containers = { LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }
    local idx = 0

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                idx = idx + 1
                local isFruit, baseNameHint = IsFruitTool(item)
                if isFruit then
                    local cleanName = ExtractCleanFruitName(baseNameHint or item.Name)
                    local muts, isNormal = ExtractFruitMutations(item)
                    local isFav = item:GetAttribute("Favorite") == true
                        or item:GetAttribute("IsFavorite") == true
                        or item:GetAttribute("d") == true
                    local uuid = GetItemUUID(item)

                    table.insert(fruits, {
                        Tool = item,
                        RawName = item.Name,
                        CleanName = cleanName,
                        Mutations = muts,
                        IsNormal = isNormal,
                        IsFavorite = isFav,
                        UUID = uuid,
                        Index = idx
                    })

                    discovered[cleanName] = true
                    counts[cleanName] = (counts[cleanName] or 0) + 1
                end
            end
        end
    end

    -- HANYA menampilkan buah yang benar-benar ada di dalam tas (stok > 0)
    local discList = {}
    for fName, cnt in pairs(counts) do
        if cnt > 0 then
            table.insert(discList, fName)
        end
    end
    table.sort(discList)

    State.DiscoveredFruits = discList
    State.BagFruitCounts = counts

    return fruits
end

-- Cek apakah buah memenuhi kriteria Pemilihan Buah & Filter Mutasi
local function IsFruitEligible(fruitInfo)
    -- 1. Cek proteksi favorit
    if Config.SkipFavorited and fruitInfo.IsFavorite then
        return false
    end

    -- 2. Cek Pemilihan Buah
    if not Config.SelectAllFruits then
        local allowedFruit = Config.SelectedFruits[fruitInfo.CleanName]
        if not allowedFruit then
            return false
        end
    end

    -- 3. Cek Filter Mutasi
    if Config.SelectedMutations["All"] == true then
        return true
    end

    -- Jika buah polos (tanpa mutasi)
    if fruitInfo.IsNormal then
        return Config.SelectedMutations["Normal"] == true
    end

    -- Jika memiliki mutasi, cek apakah salah satu mutasinya dicentang
    for _, mut in ipairs(fruitInfo.Mutations) do
        if Config.SelectedMutations[mut] == true then
            return true
        end
    end

    return false
end

