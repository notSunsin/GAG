            label.Text = string.format("%s (Stok: %d)", fruitName, stock)
            label.TextColor3 = isChecked and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 170, 190)
            label.Font = Enum.Font.Gotham
            label.TextSize = 11
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = row

            local function ToggleRow()
                Config.SelectAllFruits = false
                Config.SelectedFruits[fruitName] = not Config.SelectedFruits[fruitName]
                local checked = Config.SelectedFruits[fruitName] == true
                box.Text = checked and "X" or ""
                box.BackgroundColor3 = checked and Color3.fromRGB(0, 180, 216) or Color3.fromRGB(36, 42, 58)
                row.BackgroundColor3 = checked and Color3.fromRGB(24, 40, 54) or Color3.fromRGB(22, 26, 36)
                label.TextColor3 = checked and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 170, 190)
