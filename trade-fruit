local function UpdateFruitTriggerSummary()
    local arrow = (FruitDropdownContainer and FruitDropdownContainer.Visible) and "[^]" or "[v]"
    if #State.DiscoveredFruits == 0 then
        FruitDropdownTrigger.Text = string.format("  Pilih Jenis Buah: [Tas Kosong / 0 Buah]  %s", arrow)
    elseif Config.SelectAllFruits then
        local totalFruits = 0
        for _, cnt in pairs(State.BagFruitCounts) do
            totalFruits = totalFruits + cnt
        end
        FruitDropdownTrigger.Text = string.format("  Pilih Jenis Buah: [Semua di Tas (%d jenis - %d buah)]  %s", #State.DiscoveredFruits, totalFruits, arrow)
    else
        local count = 0
        local names = {}
        for fName, sel in pairs(Config.SelectedFruits) do
            if sel and (State.BagFruitCounts[fName] or 0) > 0 then
                count = count + 1
                table.insert(names, fName)
            end
        end
        if count == 0 then
            FruitDropdownTrigger.Text = string.format("  Pilih Jenis Buah: [Tidak Ada Terpilih]  %s", arrow)
        elseif count == 1 then
            local qty = State.BagFruitCounts[names[1]] or 0
            FruitDropdownTrigger.Text = string.format("  Pilih Jenis Buah: [%s (%d buah)]  %s", names[1], qty, arrow)
        else
            FruitDropdownTrigger.Text = string.format("  Pilih Jenis Buah: [%d Jenis Terpilih]  %s", count, arrow)
        end
    end
end

RefreshFruitDropdownUI = function()
    for _, child in ipairs(FruitListScroll:GetChildren()) do
