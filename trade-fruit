-- Kirim Trade Request ke Penerima
local function SendTradeRequestToTarget()
    if not Config.TargetPlayerName or Config.TargetPlayerName == "" then
        return false, "Nama target penerima belum dipilih/diisi!"
    end

    local targetPlayer = FindPlayerByName(Config.TargetPlayerName)
    if not targetPlayer then
        return false, string.format("Pemain '%s' tidak ditemukan di server!", Config.TargetPlayerName)
    end

    local okHold, holdMsg = HoldTradingTicket()
    if not okHold then
        return false, holdMsg
    end

    if Config.AutoStandNearTarget then
        StandNearPlayer(targetPlayer)
    end

    task.wait(0.15)

    local sentOk = false
    if TradeRequestController and TradeRequestController.SendRequest then
        pcall(function()
            TradeRequestController:SendRequest(targetPlayer)
            sentOk = true
        end)
    end

    if not sentOk and SendRequestRemote then
        pcall(function()
            SendRequestRemote:FireServer(targetPlayer)
            sentOk = true
        end)
    end

    if not sentOk then
        return false, "Gagal mengirim request ke remote SendRequest!"
    end

    return true, string.format("Mengirim Trade Request ke @%s...", targetPlayer.Name)
end

-- Loop Utama Auto Gift (Sender Loop)
local function StartAutoGiftLoop()
    if State.IsLoopRunning then return end
    State.IsLoopRunning = true

    task.spawn(function()
        AppendLog("[AUTO GIFT] Loop Auto Gift diaktifkan!", Color3.fromRGB(100, 255, 140))

        while Config.AutoGift do
            -- 1. Cek apakah ada buah yang memenuhi syarat
            local fruits = ScanBackpackFruits()
            local eligibleCount = 0
            for _, f in ipairs(fruits) do
                if IsFruitEligible(f) then
                    eligibleCount = eligibleCount + 1
                end
            end

            if eligibleCount == 0 then
                AppendLog("[AUTO GIFT] Tidak ada buah di tas yang cocok dengan filter! Menunggu stok...", Color3.fromRGB(255, 180, 100))
                UpdateStatusUI("Stok buah cocok habis")
                task.wait(4.0)
            else
                -- 2. Jika sedang tidak dalam trade, kirim request
                if not State.IsTradeActive then
                    UpdateStatusUI("Mempersiapkan Trade...")
                    local ok, msg = SendTradeRequestToTarget()
                    AppendLog(string.format("[AUTO GIFT] %s (Sisa %d buah cocok)", msg, eligibleCount), ok and Color3.fromRGB(130, 220, 255) or Color3.fromRGB(255, 100, 100))

                    -- Tunggu respon penerima
                    local waitStart = tick()
                    while not State.IsTradeActive and Config.AutoGift and (tick() - waitStart < 5.0) do
                        task.wait(0.5)
                    end
                else
                    -- Sedang dalam trade, tunggu sesi selesai
                    while State.IsTradeActive and Config.AutoGift do
                        task.wait(0.5)
                    end
                    task.wait(1.5) -- Jeda antar sesi trade
                end
            end

            task.wait(1.5)
        end

        State.IsLoopRunning = false
        AppendLog("[AUTO GIFT] Loop Auto Gift dihentikan.", Color3.fromRGB(255, 180, 180))
        UpdateStatusUI("Idle")
    end)
end

