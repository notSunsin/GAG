-- ==============================================================================
-- LOGIKA AUTO-BUY EVENT SHOP
-- ==============================================================================

local function buyAllFromShop(shopName)
    if not BuyEventShopStock then return end
    
    if DataService then
        local data = DataService:GetData()
        local eventStock = data and data.EventShopStock and data.EventShopStock[shopName]
        if eventStock and eventStock.Stocks then
            for itemName, sData in pairs(eventStock.Stocks) do
                if sData.Stock and sData.Stock > 0 then
                    BuyEventShopStock:FireServer(itemName, shopName)
                end
            end
            return
        end
    end
    
    if EventShopData and EventShopData[shopName] then
        for itemName, _ in pairs(EventShopData[shopName]) do
            BuyEventShopStock:FireServer(itemName, shopName)
        end
    end
end

-- Auto-Buy Loop Task
task.spawn(function()
    while task.wait(10) do
        if Config.AutoBuyEventShop then
            -- 1. Blood Moon Shop
            if Config.ShopAutoBuyBloodMoonAll then
                buyAllFromShop("Blood Moon Shop")
            end

            -- 2. Twilight Shop
            if Config.ShopAutoBuyTwilight then
                buyAllFromShop("Twilight Shop")
            end

            -- 3. Easter Shop
            if Config.ShopAutoBuyEasterAll then
                buyAllFromShop("Easter Seed Shop")
                if BuyEasterStock and DataService then
                    local data = DataService:GetData()
                    local easterData = data and data.EventShopStock and data.EventShopStock["Easter Seed Shop"]
                    if easterData and easterData.Stocks then
                        for seedName, sData in pairs(easterData.Stocks) do
                            if sData.Stock and sData.Stock > 0 then
                                BuyEasterStock:FireServer(seedName)
                            end
                        end
                    end
                end
            end

            -- 4. All Database Shops
            if Config.ShopAutoBuyAllDatabaseShops then
                for _, shopName in ipairs(ITEM_DATABASE.EventShops) do
                    buyAllFromShop(shopName)
                end
            end
        end
    end
end)

-- ==============================================================================
-- DRAGGABLE UI SUPPORT
-- ==============================================================================

local isDragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isDragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and isDragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

