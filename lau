-- Fungsi Cek Posisi Trade World
local function isTradeWorld()
    local success, TradeWorldData = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Data"):WaitForChild("TradeWorldData"))
    end)
    if success and TradeWorldData then
        return (game.PlaceId == TradeWorldData.PlaceId) or (TradeWorldData.ForceInWorld == true)
    end
    return false
end

-- Fungsi Toggle 3D Rendering
local function toggle3dRendering(disabled)
    pcall(function()
        RunService:Set3dRenderingEnabled(not disabled)
    end)
end


