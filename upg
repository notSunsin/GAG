-- 5. Helper Function Data
local function GetPlayerData()
    local success, data = pcall(function()
        local ds = require(DataServiceModule)
        return ds:GetData()
    end)
    if success and data and data.PetsData then
        return data
    end
    return nil
end

local function GetSlotCount(dataKey, slotKey)
    local actual = 0
    local data = GetPlayerData()
    if data and data.PetsData then
        actual = tonumber(data.PetsData[dataKey]) or 0
    end
    if slotKey and optimisticSlots[slotKey] then
        if actual > optimisticSlots[slotKey] then
            optimisticSlots[slotKey] = actual
        end
        return math.max(actual, optimisticSlots[slotKey])
    end
    return actual
end

