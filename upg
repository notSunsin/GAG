local function RefreshTumbalListUI()
    local allPets, _ = GetInventoryPets()
    local ownedCounts = { ["Dog"] = 0, ["Golden Lab"] = 0, ["Bunny"] = 0 }
    local readyCounts = { ["Dog"] = 0, ["Golden Lab"] = 0, ["Bunny"] = 0 }

    for _, p in ipairs(allPets) do
        if ownedCounts[p.PetType] ~= nil then
            ownedCounts[p.PetType] = ownedCounts[p.PetType] + 1
            if not p.IsFavorite and not p.IsEquipped and not recentlySacrificed[p.UUID] then
                if p.Level >= 20 and (not Config.MaxAgeCapEnabled or p.Level <= Config.MaxAgeCap) then
                    readyCounts[p.PetType] = readyCounts[p.PetType] + 1
                end
            end
        end
    end

    for petType, ui in pairs(TumbalCardsUI) do
        local owned = ownedCounts[petType] or 0
        local ready = readyCounts[petType] or 0
        ui.CountLabel.Text = string.format("Di Tas: %d | Siap: %d", owned, ready)
    end
end

