                        BottomSub.Text = string.format("[Klik %d/%d | %s] Tumbal: %s (U:%d) -> Lvl %d...", 
                            clickIter, MAX_CLICKS, slotCfg.ShortName, candidate.PetType, candidate.Level, nextLevel)
                        BottomSub.TextColor3 = Color3.fromRGB(130, 215, 255)

                        local ok, _ = pcall(function()
                            UnlockSlotFromPet:FireServer(candidate.UUID, slotCfg.Key)
                        end)

                        if ok then
                            totalUpgrades = totalUpgrades + 1
                            didUpgradeInCycle = true
                        end

                        task.wait(Config.UpgradeDelay)
                        pcall(UpdateSlotCardsUI)
                    end
                end
            end

            -- Cek apakah semua slot sudah maksimal
            local allMax = true
            for _, slotCfg in ipairs(SLOT_TYPES) do
                if GetSlotCount(slotCfg.DataKey, slotCfg.Key) < slotCfg.Max then
                    allMax = false
                    break
                end
            end

            if allMax then
                BottomSub.Text = string.format("SEMUA SLOT TELAH MAKSIMAL (5/5)! Total: %d slot.", totalUpgrades)
                BottomSub.TextColor3 = Color3.fromRGB(100, 255, 140)
                break
            end

            if not didUpgradeInCycle then
                BottomSub.Text = string.format("Selesai (Klik %d/%d)! Berhasil %d upgrade (Tumbal di tas habis).", 
                    clickIter, MAX_CLICKS, totalUpgrades)
                BottomSub.TextColor3 = Color3.fromRGB(255, 200, 100)
                break
            end

            task.wait(Config.UpgradeDelay)
        end

        isUpgradingRunning = false
        pcall(UpdateSlotCardsUI)

        -- Resinkronisasi dengan server setelah delay singkat
        task.delay(0.8, function()
            local data = GetPlayerData()
            if data and data.PetsData then
                for _, slotCfg in ipairs(SLOT_TYPES) do
                    optimisticSlots[slotCfg.Key] = tonumber(data.PetsData[slotCfg.DataKey]) or 0
                end
                pcall(UpdateSlotCardsUI)
            end
        end)

        local allMax = true
        for _, slotCfg in ipairs(SLOT_TYPES) do
            if GetSlotCount(slotCfg.DataKey, slotCfg.Key) < slotCfg.Max then
                allMax = false
                break
            end
        end

        if allMax then
            Main1ClickBtn.Text = "SEMUA SLOT TELAH MAKSIMAL (5/5)"
            Main1ClickBtn.BackgroundColor3 = Color3.fromRGB(45, 65, 85)
        else
            Main1ClickBtn.Text = "UPGRADE SEMUA SLOT KE MAKS (1-KLIK)"
            Main1ClickBtn.BackgroundColor3 = Color3.fromRGB(35, 140, 70)
        end
    end)
end)

