-- Helper membaca detail penawaran trade saat ini
local function GetCurrentTradeDetails()
    local replicator = TradingController and TradingController.CurrentTradeReplicator
    if replicator then
        local data = nil
        pcall(function()
            data = replicator:GetData()
        end)

        if data and data.players and data.offers then
            local myIdx = table.find(data.players, LocalPlayer)
            local otherIdx = (myIdx == 1) and 2 or 1
            local otherPlayer = data.players[otherIdx]
            local otherPlayerName = otherPlayer and otherPlayer.Name or "Pemain"

            local myState = "None"
            local otherState = "None"
            if myIdx and data.states then
                myState = data.states[myIdx] or "None"
            end
            if otherIdx and data.states then
                otherState = data.states[otherIdx] or "None"
            end

            local cooldownRemain = 0
            if data.lastChange then
                local elapsed = workspace:GetServerTimeNow() - data.lastChange
                cooldownRemain = math.max(0, 5 - elapsed)
            end

            local myItemsCount = 0
            local mySheckles = 0
            local myTokens = 0
            local myOffer = myIdx and data.offers[myIdx]
            if myOffer then
                myItemsCount = #(myOffer.items or {})
                mySheckles = myOffer.sheckles or 0
                myTokens = myOffer.tokens or 0
            end

            local otherOffer = otherIdx and data.offers[otherIdx]
            local otherPetsCount = 0
            local otherTumbalCount = 0
            local otherItemsList = {}

            if otherOffer and otherOffer.items then
                for _, item in ipairs(otherOffer.items) do
                    table.insert(otherItemsList, item)
                    if item.type == "Pet" then
                        otherPetsCount = otherPetsCount + 1
                        local pType = (item.data and item.data.PetType) or ""
                        if Config.AllowedTumbalPets[pType] == true then
                            otherTumbalCount = otherTumbalCount + 1
                        end
                    end
                end
            end

            return true, {
                OtherPlayerName = otherPlayerName,
                MyItemsCount = myItemsCount,
                MySheckles = mySheckles,
                MyTokens = myTokens,
                OtherPetsCount = otherPetsCount,
                OtherTumbalCount = otherTumbalCount,
                TotalOtherItems = #otherItemsList,
                CooldownRemaining = cooldownRemain,
                MyState = myState,
                OtherState = otherState
            }
        end
    end

    -- Fallback membaca dari PlayerGui.TradingUI.LiveTrade
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local tradingUI = pGui and pGui:FindFirstChild("TradingUI")
    local liveTrade = tradingUI and tradingUI:FindFirstChild("LiveTrade")
    if liveTrade and liveTrade.Visible then
        local otherPlr = liveTrade:FindFirstChild("OtherPlr")
        local myPlr = liveTrade:FindFirstChild("MyPlr")
        local options = liveTrade:FindFirstChild("Options")
        local acceptBtn = options and options:FindFirstChild("Accept")
        local acceptLabel = acceptBtn and acceptBtn:FindFirstChild("Label")

        local otherName = "Pemain"
        pcall(function()
            local pNameText = otherPlr and otherPlr:FindFirstChild("Price") and otherPlr.Price:FindFirstChild("Label")
            if pNameText and pNameText.Text then
                otherName = pNameText.Text:match("@([^']+)") or "Pemain"
            end
        end)

        local cooldownRemain = 0
        local myState = "None"
        local otherState = "None"

        if acceptLabel then
            local txt = acceptLabel.Text
            local sec = txt:match("(%d+%.?%d*)s")
            if sec then
                cooldownRemain = tonumber(sec) or 0
            end
            if txt == "Accepted" then
                myState = "Accepted"
            elseif txt == "Confirm" then
                myState = "Accepted"
                otherState = "Accepted"
            elseif txt == "Confirmed" then
                myState = "Confirmed"
            end
        end

        local otherPetsCount = 0
        if otherPlr and otherPlr:FindFirstChild("ScrollingFrame") then
            for _, child in ipairs(otherPlr.ScrollingFrame:GetChildren()) do
                if child:IsA("GuiObject") and child.Visible and child.Name ~= "AddItemButtom" then
                    otherPetsCount = otherPetsCount + 1
                end
            end
        end

        local myItemsCount = 0
        if myPlr and myPlr:FindFirstChild("ScrollingFrame") then
            for _, child in ipairs(myPlr.ScrollingFrame:GetChildren()) do
                if child:IsA("GuiObject") and child.Visible and child.Name ~= "AddItemButtom" and child.Name ~= "ItemTemplate" then
                    myItemsCount = myItemsCount + 1
                end
            end
        end

        return true, {
            OtherPlayerName = otherName,
            MyItemsCount = myItemsCount,
            MySheckles = 0,
            MyTokens = 0,
            OtherPetsCount = otherPetsCount,
            OtherTumbalCount = otherPetsCount,
            TotalOtherItems = otherPetsCount,
            CooldownRemaining = cooldownRemain,
            MyState = myState,
            OtherState = otherState
        }
    end

    return false, nil
end

-- Evaluasi kelayakan penawaran trade berdasarkan konfigurasi user
local function EvaluateTradeOffer(info)
    if not Config.AutoTradePet then
        return false, "Fitur Auto Trade sedang dinonaktifkan."
    end

    -- 1. PROTEKSI KEAMANAN ANTI-SCAM:
    if Config.SafetyDeclineIfWeOffer then
        if info.MyItemsCount > 0 or info.MySheckles > 0 or info.MyTokens > 0 then
            return false, "ANTI-SCAM: Penawaran Anda tidak kosong! Trade dibatalkan demi keamanan."
        end
    end

    local currentTumbal, _ = GetTumbalCounts()
    local offeredRelevant = (Config.TradePetFilter == "TumbalOnly") and info.OtherTumbalCount or info.OtherPetsCount

    -- Kondisi A: Menerima 15 pet saja (atau target pet count)
    local condMenerima15 = (offeredRelevant >= Config.TradeTargetPetCount)

    -- Kondisi B: Total pet tumbal di tas saat ini + incoming tepat = 15
    local condTotalTas15 = (currentTumbal + offeredRelevant == Config.TradeTargetInventoryCount)

    -- Kondisi C: Tas saat ini belum 15 dan menerima cukup pet hingga tas mencapai/melebihi 15
    local condReachTas15 = (currentTumbal < Config.TradeTargetInventoryCount and (currentTumbal + offeredRelevant >= Config.TradeTargetInventoryCount))

    local isEligible = false
    if Config.TradeConditionMode == "Exact15" then
        isEligible = condMenerima15
    elseif Config.TradeConditionMode == "TargetInventory15" then
        isEligible = condTotalTas15 or condReachTas15
    else -- "Both" (Default: Menerima 15 Pet Saja ATAU Total Tas = 15)
        isEligible = condMenerima15 or condTotalTas15 or condReachTas15
    end

    if not isEligible then
        return false, string.format("Menunggu syarat: Ditawarkan %d/%d pet | Tas: %d/%d tumbal",
            offeredRelevant, Config.TradeTargetPetCount, currentTumbal, Config.TradeTargetInventoryCount)
    end

    return true, string.format("Syarat TERPENUHI! (%d pet | Tas: %d/15)", offeredRelevant, currentTumbal + offeredRelevant)
end

-- Eksekusi logika trade per frame / loop
local function ProcessPlazaTrade()
    local isTrading, info = GetCurrentTradeDetails()
    TradeRuntime.IsTrading = isTrading

    local currentTumbal, readyTumbal = GetTumbalCounts()
    TradeRuntime.CurrentInventoryTumbal = currentTumbal

    if not isTrading or not info then
        return
    end

    -- Update info runtime saat sedang trade
    TradeRuntime.OtherPlayerName = info.OtherPlayerName
    TradeRuntime.OfferedPets = info.OtherPetsCount
    TradeRuntime.OfferedTumbal = info.OtherTumbalCount
    TradeRuntime.MyItemsCount = info.MyItemsCount
    TradeRuntime.CooldownRemaining = info.CooldownRemaining
    TradeRuntime.MyState = info.MyState
    TradeRuntime.OtherState = info.OtherState

    -- Cek anti-scam jika akun kita ikut menawarkan item
    if Config.SafetyDeclineIfWeOffer and (info.MyItemsCount > 0 or info.MySheckles > 0 or info.MyTokens > 0) then
        TradeRuntime.StatusText = "TOLAK TRADE (Anti-Scam)"
        TradeRuntime.StatusColor = Color3.fromRGB(255, 80, 80)
        TradeRuntime.DetailText = "Penawaran Anda terisi! Menolak trade otomatis..."

        pcall(function()
            if DeclineRemote then DeclineRemote:FireServer() end
            if TradingController then TradingController:Decline() end
        end)
        return
    end

    -- Evaluasi kelayakan
    local isEligible, reason = EvaluateTradeOffer(info)
    if not isEligible then
        TradeRuntime.StatusText = "Menunggu Penawaran 15 Pet..."
        TradeRuntime.StatusColor = Color3.fromRGB(255, 200, 90)
        TradeRuntime.DetailText = string.format("@%s menawarkan %d pet (%s)", 
            info.OtherPlayerName, info.OtherTumbalCount, reason)
        return
    end

    -- Syarat terpenuhi! Handle proses Accept & Confirm
    local offeredCount = (Config.TradePetFilter == "TumbalOnly") and info.OtherTumbalCount or info.OtherPetsCount
    TradeRuntime.DetailText = string.format("@%s memberi %d pet. %s", info.OtherPlayerName, offeredCount, reason)

    -- Auto klik "Yes" jika ada Unfair Trade Popup
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        local unfairGui = pGui and pGui:FindFirstChild("UnfairTrade")
        if unfairGui and unfairGui.Enabled then
            local uFrame = unfairGui:FindFirstChild("UnfairTrade")
            if uFrame and uFrame.Visible then
                local options = uFrame:FindFirstChild("Options")
                local yesBtn = options and options:FindFirstChild("Yes")
                if yesBtn then
                    for _, c in ipairs(getconnections and getconnections(yesBtn.Activated) or {}) do
                        c:Fire()
                    end
                end
            end
        end
    end)

    -- Cek jeda cooldown server (5 detik)
    if info.CooldownRemaining > 0.1 then
        TradeRuntime.StatusText = string.format("Jeda Server: %.1fs...", info.CooldownRemaining)
        TradeRuntime.StatusColor = Color3.fromRGB(255, 220, 100)
        return
    end

    -- Tahap 1: Mengirim Accept
    if info.MyState == "None" then
        TradeRuntime.StatusText = "Mengirim Accept..."
        TradeRuntime.StatusColor = Color3.fromRGB(100, 220, 255)

        pcall(function()
            if AcceptRemote then
                AcceptRemote:FireServer()
            end
            if TradingController then
                TradingController:Accept()
            end
        end)
        return
    end

    -- Tahap 2: Mengirim Confirm
    if info.MyState == "Accepted" then
        if info.OtherState == "Accepted" or info.CooldownRemaining <= 0 then
            TradeRuntime.StatusText = "Mengirim Confirm..."
            TradeRuntime.StatusColor = Color3.fromRGB(120, 255, 150)

            pcall(function()
                if ConfirmRemote then
                    ConfirmRemote:FireServer()
                end
                if TradingController then
                    TradingController:Confirm()
                end
            end)
            Stats.TotalTradesAccepted = Stats.TotalTradesAccepted + 1
        else
            TradeRuntime.StatusText = string.format("Menunggu @%s Accept...", info.OtherPlayerName)
            TradeRuntime.StatusColor = Color3.fromRGB(255, 215, 110)
        end
        return
    end

    -- Tahap 3: Selesai / Terkonfirmasi
    if info.MyState == "Confirmed" then
        TradeRuntime.StatusText = "Trade Dikonfirmasi!"
        TradeRuntime.StatusColor = Color3.fromRGB(100, 255, 140)
        TradeRuntime.DetailText = "Menunggu server mentransfer pet ke tas..."
    end
end

