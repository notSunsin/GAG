local function UpdateSlotCardsUI()
    for _, slotCfg in ipairs(SLOT_TYPES) do
        local ui = CardUIElements[slotCfg.Key]
        if ui then
            local current = GetSlotCount(slotCfg.DataKey, slotCfg.Key)
            ui.StatusLabel.Text = string.format("Lvl %d / %d", current, slotCfg.Max)

            if current >= slotCfg.Max then
                ui.ReqLabel.Text = "Status: MAKS (5/5)"
                ui.ReqLabel.TextColor3 = Color3.fromRGB(100, 255, 140)
                ui.CandLabel.Text = "Sudah Maksimal"
                ui.CandLabel.TextColor3 = Color3.fromRGB(150, 160, 175)
            else
                local nextLevel = current + 1
                local reqAge = REQUIRED_AGES[nextLevel] or 999
                ui.ReqLabel.Text = string.format("Syarat: Umur >= %d", reqAge)
                ui.ReqLabel.TextColor3 = Color3.fromRGB(255, 215, 0)

                local cand, list = FindSacrificeCandidate(reqAge)
                if cand then
                    ui.CandLabel.Text = string.format("Siap: %s (U:%d) [%d]", cand.PetType, cand.Level, #list)
                    ui.CandLabel.TextColor3 = Color3.fromRGB(100, 230, 140)
                else
                    ui.CandLabel.Text = "Kurang tumbal"
                    ui.CandLabel.TextColor3 = Color3.fromRGB(240, 120, 100)
                end
            end
        end
    end
end

