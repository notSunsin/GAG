local function UpdateAutoTabUI()
    local data = GetPlayerData()
    if not data then return end

    if data.RebirthData then
        local totalRebirths = data.RebirthData.TotalRebirths or 0
        local price = 0
        local isAvail = false

        if RebirthShared then
            pcall(function()
                price = RebirthShared:CalculatePrice(totalRebirths, LocalPlayer)
                isAvail = RebirthShared:IsRebirthAvailable(LocalPlayer)
            end)
        else
            local resetTime = (RebirthConfigData and RebirthConfigData.RESET_TIME) or 1800
            isAvail = (data.RebirthData.LastRebirthTime + resetTime) <= workspace:GetServerTimeNow()
        end

        local sheckles = data.Sheckles or 0
        local resetRemain = 0
        if RebirthConfigData and data.RebirthData.LastRebirthTime then
            resetRemain = (data.RebirthData.LastRebirthTime + RebirthConfigData.RESET_TIME) - math.floor(workspace:GetServerTimeNow())
        end

        if isAvail and sheckles >= price then
            AscendStatusLbl.Text = "SIAP ASCEND! (Syarat Terpenuhi)"
            AscendStatusLbl.TextColor3 = Color3.fromRGB(100, 255, 140)
        elseif not isAvail then
            local timeText = resetRemain > 0 and string.format("%02d:%02d", math.floor(resetRemain / 60), resetRemain % 60) or "00:00"
            AscendStatusLbl.Text = "Cooldown Reset: " .. timeText
            AscendStatusLbl.TextColor3 = Color3.fromRGB(255, 180, 80)
        else
            AscendStatusLbl.Text = "Kurang Sheckles untuk Ascend!"
            AscendStatusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
        end

        AscendReqLbl.Text = string.format("Ascends: %d | Harga: %s", totalRebirths, tostring(price))
    end

    if data.GearStock and data.GearStock.Stocks then
        local ticketData = data.GearStock.Stocks["Trading Ticket"]
        local stock = ticketData and tonumber(ticketData.Stock) or 0
