local isUpgradingRunning = false

Main1ClickBtn.MouseButton1Click:Connect(function()
    if isUpgradingRunning then
        isUpgradingRunning = false
        Main1ClickBtn.Text = "UPGRADE SEMUA SLOT KE MAKS (1-KLIK)"
        Main1ClickBtn.BackgroundColor3 = Color3.fromRGB(35, 140, 70)
        BottomSub.Text = "Proses dihentikan pengguna."
        BottomSub.TextColor3 = Color3.fromRGB(255, 140, 140)
        return
    end

    if not UnlockSlotFromPet then
        BottomSub.Text = "Remote UnlockSlotFromPet tidak ditemukan!"
        BottomSub.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    isUpgradingRunning = true
    Main1ClickBtn.BackgroundColor3 = Color3.fromRGB(180, 105, 25)

    task.spawn(function()
        local totalUpgrades = 0
        local MAX_CLICKS = 10

        for clickIter = 1, MAX_CLICKS do
            if not isUpgradingRunning then break end

            Main1ClickBtn.Text = string.format("EKSEKUSI KLIK [%d/%d]... [STOP]", clickIter, MAX_CLICKS)
            BottomSub.Text = string.format("Eksekusi Klik ke-%d dari %d (Jeda %.2fs)...", clickIter, MAX_CLICKS, Config.UpgradeDelay)
            BottomSub.TextColor3 = Color3.fromRGB(255, 220, 120)

            local didUpgradeInCycle = false

            for _, slotCfg in ipairs(SLOT_TYPES) do
                if not isUpgradingRunning then break end

                local current = GetSlotCount(slotCfg.DataKey, slotCfg.Key)
                if current < slotCfg.Max then
                    local nextLevel = current + 1
                    local reqAge = REQUIRED_AGES[nextLevel] or 999
                    local candidate, _ = FindSacrificeCandidate(reqAge)

                    if candidate then
                        recentlySacrificed[candidate.UUID] = true
                        optimisticSlots[slotCfg.Key] = current + 1

                        BottomSub.Text = string.format("[Klik %d/%d | %s] Tumbal: %s (U:%d) -> Lvl %d...", 
                            clickIter, MAX_CLICKS, slotCfg.ShortName, candidate.PetType, candidate.Level, nextLevel)
                        BottomSub.TextColor3 = Color3.fromRGB(130, 215, 255)

                        local ok, _ = pcall(function()
                            UnlockSlotFromPet:FireServer(candidate.UUID, slotCfg.Key)
                        end)

                        if ok then
                            totalUpgrades = totalUpgrades + 1
                            didUpgradeInCycle = true
                        end

                        task.wait(Config.UpgradeDelay)
                        pcall(UpdateSlotCardsUI)
                    end
                end
            end

            -- Cek apakah semua slot sudah maksimal
            local allMax = true
            for _, slotCfg in ipairs(SLOT_TYPES) do
                if GetSlotCount(slotCfg.DataKey, slotCfg.Key) < slotCfg.Max then
                    allMax = false
                    break
                end
            end

            if allMax then
                BottomSub.Text = string.format("SEMUA SLOT TELAH MAKSIMAL (5/5)! Total: %d slot.", totalUpgrades)
                BottomSub.TextColor3 = Color3.fromRGB(100, 255, 140)
                break
            end

            if not didUpgradeInCycle then
                BottomSub.Text = string.format("Selesai (Klik %d/%d)! Berhasil %d upgrade (Tumbal di tas habis).", 
                    clickIter, MAX_CLICKS, totalUpgrades)
                BottomSub.TextColor3 = Color3.fromRGB(255, 200, 100)
                break
            end

            task.wait(Config.UpgradeDelay)
        end

        isUpgradingRunning = false
        pcall(UpdateSlotCardsUI)

        -- Resinkronisasi dengan server setelah delay singkat
        task.delay(0.8, function()
            local data = GetPlayerData()
            if data and data.PetsData then
                for _, slotCfg in ipairs(SLOT_TYPES) do
                    optimisticSlots[slotCfg.Key] = tonumber(data.PetsData[slotCfg.DataKey]) or 0
                end
                pcall(UpdateSlotCardsUI)
            end
        end)

        local allMax = true
        for _, slotCfg in ipairs(SLOT_TYPES) do
            if GetSlotCount(slotCfg.DataKey, slotCfg.Key) < slotCfg.Max then
                allMax = false
                break
            end
        end

        if allMax then
            Main1ClickBtn.Text = "SEMUA SLOT TELAH MAKSIMAL (5/5)"
            Main1ClickBtn.BackgroundColor3 = Color3.fromRGB(45, 65, 85)
        else
            Main1ClickBtn.Text = "UPGRADE SEMUA SLOT KE MAKS (1-KLIK)"
            Main1ClickBtn.BackgroundColor3 = Color3.fromRGB(35, 140, 70)
        end
    end)
end)

