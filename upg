        BottomSub.Text = "Remote UnlockSlotFromPet tidak ditemukan!"
        BottomSub.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    isUpgradingRunning = true
    Main1ClickBtn.BackgroundColor3 = Color3.fromRGB(180, 105, 25)

