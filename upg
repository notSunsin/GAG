end

-- 6. Helper Pencarian Pet Tumbal (Khusus Dog, Golden Lab, Bunny)
local function GetInventoryPets()
    local data = GetPlayerData()
    if not data or not data.PetsData or not data.PetsData.PetInventory then
        return {}, {}
    end

    local invData = data.PetsData.PetInventory.Data or {}
    local equipped = data.PetsData.EquippedPets or {}
    local petsList = {}

    -- Bersihkan daftar recentlySacrificed untuk pet yang sudah hilang dari tas
    for uuid in pairs(recentlySacrificed) do
        if not invData[uuid] then
            recentlySacrificed[uuid] = nil
        end
    end

    for uuid, petObj in pairs(invData) do
        local petData = petObj.PetData or {}
        local petType = petObj.PetType or "Unknown"
        local level = tonumber(petData.Level) or 0
        local isFav = petData.IsFavorite == true
        local isEquipped = table.find(equipped, uuid) ~= nil
        local isMutated = petData.Mutation ~= nil and petData.Mutation ~= ""

        table.insert(petsList, {
            UUID = uuid,
            PetType = petType,
            Level = level,
            Weight = petData.BaseWeight or 0,
            Name = petData.Name or petType,
            IsFavorite = isFav,
            IsEquipped = isEquipped,
            IsMutated = isMutated,
            Raw = petObj
        })
    end

    return petsList, equipped
end

local function FindSacrificeCandidate(minAge)
    local allPets, _ = GetInventoryPets()
    local candidates = {}

    for _, pet in ipairs(allPets) do
        if not pet.IsFavorite and not pet.IsEquipped and not recentlySacrificed[pet.UUID] then
            if Config.AllowedTumbalPets[pet.PetType] == true then
                if not (Config.ProtectMutated and pet.IsMutated) then
                    if pet.Level >= minAge then
                        if not Config.MaxAgeCapEnabled or pet.Level <= Config.MaxAgeCap then
                            table.insert(candidates, pet)
                        end
                    end
                end
            end
        end
    end

    if #candidates == 0 then
        return nil, candidates
    end

    table.sort(candidates, function(a, b)
        return a.Level < b.Level
    end)

    return candidates[1], candidates
end

-- 7. Logika Auto Ascend & Auto Buy Trading Ticket
local function CheckAndAutoAscend()
    if not Config.AutoAscend or not BuyRebirth then return end

    local data = GetPlayerData()
    if not data or not data.RebirthData or not data.Sheckles then return end

    local isAvailable = false
    local price = 0

    if RebirthShared then
        local ok1, res1 = pcall(function() return RebirthShared:IsRebirthAvailable(LocalPlayer) end)
        local ok2, res2 = pcall(function() return RebirthShared:CalculatePrice(data.RebirthData.TotalRebirths, LocalPlayer) end)
        isAvailable = ok1 and res1
        price = ok2 and res2 or 0
    else
        local resetTime = (RebirthConfigData and RebirthConfigData.RESET_TIME) or 1800
        isAvailable = (data.RebirthData.LastRebirthTime + resetTime) <= workspace:GetServerTimeNow()
        price = 1000000
    end

    if isAvailable and data.Sheckles >= price then
        pcall(function()
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local rConf = pGui and pGui:FindFirstChild("RebirthConfirmation")
            if rConf and rConf.Enabled then
                local GuiController = require(ReplicatedStorage.Modules.GuiController)
                GuiController:Close(rConf)
            end
        end)

        local ok = pcall(function()
            BuyRebirth:FireServer()
        end)
        if ok then
            Stats.TotalAscends = Stats.TotalAscends + 1
        end
    end
end

local function CheckAndAutoBuyTradeTicket()
    if not Config.AutoBuyTradeTicket or not BuyGearStock then return end

    local data = GetPlayerData()
    if not data or not data.GearStock or not data.GearStock.Stocks or not data.Sheckles then return end

    local ticketStockData = data.GearStock.Stocks["Trading Ticket"]
    local stock = ticketStockData and tonumber(ticketStockData.Stock) or 0
    local ticketPrice = 100000

    if stock > 0 and data.Sheckles >= ticketPrice then
        local ok = pcall(function()
            BuyGearStock:FireServer("Trading Ticket")
        end)
        if ok then
            Stats.TotalTicketsBought = Stats.TotalTicketsBought + 1
        end
    end
end

