-- Helper universal untuk mengeksekusi klik tombol Accept pada popup Gift di mobile
local function TriggerButtonAccept(acceptBtn, giftFrame)
    if not acceptBtn then return false end
    local clicked = false
    local foundGiftId = nil

    -- Method 1: getconnections (Ekstraksi giftId & eksekusi fungsi bawaan)
    if getconnections then
        local conns = getconnections(acceptBtn.MouseButton1Click)
        if conns and #conns > 0 then
            for _, conn in ipairs(conns) do
                -- Ekstrak giftId (UUID) dari upvalues callback game
                pcall(function()
                    if debug and debug.getupvalues and type(conn.Function) == "function" then
                        local upvals = debug.getupvalues(conn.Function)
                        for _, val in pairs(upvals) do
                            if typeof(val) == "string" and #val >= 30 and val:find("-") then
                                foundGiftId = val
                                break
                            end
                        end
                    end
                end)

                if type(conn.Function) == "function" then
                    pcall(conn.Function)
                    clicked = true
                elseif conn.Fire then
                    pcall(function() conn:Fire() end)
                    clicked = true
                end
            end
        end

        local connsAct = getconnections(acceptBtn.Activated)
        if connsAct and #connsAct > 0 then
            for _, conn in ipairs(connsAct) do
                if type(conn.Function) == "function" then
                    pcall(conn.Function)
                    clicked = true
                elseif conn.Fire then
                    pcall(function() conn:Fire() end)
                    clicked = true
                end
            end
        end
    end

    -- Jika giftId ditemukan dari upvalue, tembak langsung AcceptPetGift Remote
    if foundGiftId and AcceptPetGiftRemote then
        pcall(function()
            AcceptPetGiftRemote:FireServer(true, foundGiftId)
            print("[GAG Auto Gift] AcceptPetGift terkirim untuk ID:", foundGiftId)
        end)
    end

    -- Method 2: firesignal
    if firesignal then
        pcall(function() firesignal(acceptBtn.MouseButton1Click) end)
        pcall(function() firesignal(acceptBtn.Activated) end)
    end

    -- Method 3: VirtualInputManager simulasi sentuhan/klik
    if VirtualInputManager then
        pcall(function()
            local pos = acceptBtn.AbsolutePosition + acceptBtn.AbsoluteSize / 2
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
            clicked = true
        end)
    end

    -- Hapus instance UI pop-up dari layar agar tidak menutupi HP
    if giftFrame then
        pcall(function()
            task.delay(0.05, function()
                if giftFrame and giftFrame.Parent then
                    giftFrame:Destroy()
                end
            end)
        end)
    end

    return clicked
end

-- Memproses semua popup Gift Pet yang sedang ada di layar
local function ProcessPendingPetGifts()
    local currentTumbal, readyCount = GetTumbalCounts()

    -- JIKA ISI TAS SUDAH 15/15 TUMBAL, TOGGLE OTOMATIS DIMATIKAN (OFF)
    if currentTumbal >= Config.TradeTargetInventoryCount then
        if Config.AutoTradePet then
            Config.AutoTradePet = false
            print(string.format("[GAG Auto Trade] Tas sudah terisi %d/15 tumbal. Toggle Auto Trade otomatis MATI (OFF)!", currentTumbal))
        end
        TradeRuntime.StatusText = "Auto Trade MATI (Tas 15/15 Tumbal)"
        TradeRuntime.StatusColor = Color3.fromRGB(100, 255, 140)
        TradeRuntime.DetailText = string.format("Tas sudah memiliki %d/15 tumbal (Siap: %d). Toggle Auto Trade otomatis OFF.", 
            currentTumbal, readyCount)
        return
    end

    if not Config.AutoTradePet or not Config.AutoAcceptPetGift then return end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local giftNotif = pGui and pGui:FindFirstChild("Gift_Notification")
    local frame = giftNotif and giftNotif:FindFirstChild("Frame")
    if not frame then return end

    for _, child in ipairs(frame:GetChildren()) do
        -- 1. Cek jika ini popup Gift Pet (memiliki child 'Holder')
        local holder = child:FindFirstChild("Holder")
        if holder then
            local descLabel = holder:FindFirstChild("TextLabel")
            local notifUI = holder:FindFirstChild("Notification_UI")
            local senderLabel = notifUI and notifUI:FindFirstChild("TextLabel")
            local btnFrame = holder:FindFirstChild("Frame")
            local acceptBtn = btnFrame and btnFrame:FindFirstChild("Accept")

            if acceptBtn then
                local descText = descLabel and descLabel.Text or "Pet"
                local senderText = senderLabel and senderLabel.Text or "Pengirim"

                -- Ekstrak nama pet (contoh: "Bunny [10.22 KG] [Age 77]" -> "Bunny")
                local petType = descText:match("^(.-)%s*%[") or descText
                petType = petType:gsub("^%s*(.-)%s*$", "%1")

                -- Cek filter pet tumbal
                local isAllowed = (Config.TradePetFilter ~= "TumbalOnly") or (Config.AllowedTumbalPets[petType] == true)

                if isAllowed then
                    TradeRuntime.StatusText = "Menerima Gift: " .. petType
                    TradeRuntime.StatusColor = Color3.fromRGB(100, 255, 140)
                    TradeRuntime.DetailText = string.format("Menerima %s dari %s (Tas: %d/%d)", 
                        descText, senderText, currentTumbal, Config.TradeTargetInventoryCount)

                    TriggerButtonAccept(acceptBtn, child)
                    Stats.TotalGiftsAccepted = Stats.TotalGiftsAccepted + 1
                    task.wait(0.08)
                else
                    TradeRuntime.StatusText = "Gift Dilewati (Bukan Tumbal)"
                    TradeRuntime.DetailText = string.format("Pet '%s' bukan tumbal (Dog, Lab, Bunny)", petType)
                end
            end
        end

        -- 2. Cek jika ini popup Plaza Trade Request (memiliki child 'Wrapper')
        local wrapper = child:FindFirstChild("Wrapper")
        if wrapper and Config.AutoAcceptTradeRequest then
            local canvas = wrapper:FindFirstChild("Canvas")
            local seg = canvas and canvas:FindFirstChild("Segment")
            local buttons = seg and seg:FindFirstChild("Buttons")
            local accBtn = buttons and buttons:FindFirstChild("ACCEPT_BUTTON")
            local sensor = accBtn and accBtn:FindFirstChild("Main") and accBtn.Main:FindFirstChild("SENSOR")
            if sensor then
                TradeRuntime.StatusText = "Menerima Trade Request..."
                TradeRuntime.StatusColor = Color3.fromRGB(130, 220, 255)
                if getconnections then
                    for _, c in ipairs(getconnections(sensor.Activated) or {}) do c:Fire() end
                    for _, c in ipairs(getconnections(sensor.MouseButton1Click) or {}) do c:Fire() end
                end
                task.wait(0.08)
            end
        end
    end
end

