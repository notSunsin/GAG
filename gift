                ui.ProgressLbl.Text = string.format("%d / 15 (Sedang Kirim)", cfg.Sent)
                ui.ProgressLbl.TextColor3 = Color3.fromRGB(255, 215, 100)
            else
                ui.ProgressLbl.Text = string.format("%d / 15 (%s)", cfg.Sent, cfg.Status)
                ui.ProgressLbl.TextColor3 = Color3.fromRGB(180, 200, 220)
            end
        end
    end
end

