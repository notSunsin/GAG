                    end
                end)
            end
        end)
    end
end)

-- Memeriksa apakah ada pet yang sebelumnya terkirim lalu baru saja di-accept oleh target di background
local function CheckPendingPetsAccepted(targetIdx, targetCfg)
    local curData = GetPlayerData()
    local invData = (curData and curData.PetsData and curData.PetsData.PetInventory and curData.PetsData.PetInventory.Data) or {}
    local now = os.clock()

    for uuid, info in pairs(PendingGiftPets) do
        local tool = FindToolByUUID(uuid)
        local stillInInv = (invData[uuid] ~= nil)

        if not tool and not stillInInv then
            -- Pet ini telah diterima oleh target!
            PendingGiftPets[uuid] = nil
            if info.TargetIdx == targetIdx then
                targetCfg.Sent = targetCfg.Sent + 1
                Stats.TotalPetsSent = Stats.TotalPetsSent + 1
                print(string.format("[GAG Sender] Pet pending (%s) DITERIMA oleh @%s! (Total: %d/15)", 
                    info.Pet.Name or "Pet", info.TargetPlayer.Name, targetCfg.Sent))
            end
        elseif now >= (info.ExpireTime or 0) then
            -- Request timeout / kadaluarsa di server, hapus dari pending agar bisa dicoba kembali jika perlu
            PendingGiftPets[uuid] = nil
        end
    end
end

-- Mengirim 1 Pet ke Target Player dengan batas tunggu reaksi (4 - 6 detik)
local function SendSinglePet(targetPlayer, pet, reactionTimeout)
    reactionTimeout = reactionTimeout or (math.random(math.floor(Config.DelayMin * 10), math.floor(Config.DelayMax * 10)) / 10)

    if not PetGiftingServiceRemote then
        return false, "Remote PetGiftingService tidak ada"
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not rootPart then
        return false, "Karakter pengirim tidak valid"
    end

    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not targetChar or not targetRoot then
        return false, string.format("Karakter @%s tidak ditemukan di server", targetPlayer.Name)
    end

    -- Cek jarak & Auto-teleport jika terlalu jauh (syarat game: < 5 studs)
    local dist = (targetRoot.Position - rootPart.Position).Magnitude
    if dist > 4.5 then
        if Config.AutoTeleport then
            rootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
            task.wait(0.2)
        else
            return false, string.format("Jarak ke @%s terlalu jauh (%.1f studs > 5). Dekati target!", targetPlayer.Name, dist)
        end
    end

    -- Cari tool pet
    local petTool = FindToolByUUID(pet.UUID)
    if not petTool then
        return false, string.format("Tool pet '%s' tidak ditemukan di tas", pet.Name)
    end

    -- Equip pet tool ke tangan
    humanoid:UnequipTools()
    task.wait(0.1)
    humanoid:EquipTool(petTool)
    task.wait(0.25)

    -- Reset status deteksi warning sebelum menembak
    LastOutgoingRequestWarning = 0

    -- Tembak Remote Gift
    local fireOk = pcall(function()
        PetGiftingServiceRemote:FireServer("GivePet", targetPlayer)
    end)
    if not fireOk then
        humanoid:UnequipTools()
        return false, "Gagal menembak remote PetGiftingService"
    end

    print(string.format("[GAG Sender] Mengirim %s (%s, Age %d, BW %.2f) ke @%s (Tunggu respon max %.1fs)...", 
        pet.Name, pet.PetType, pet.Level, pet.BaseWeight, targetPlayer.Name, reactionTimeout))

    -- Tunggu hingga pet diterima atau waktu respon (4-6 detik) habis
    local startTime = os.clock()
    local isAccepted = false
    local alreadyPendingOutgoing = false

    while (os.clock() - startTime) < reactionTimeout do
        if not isSenderRunning then break end

        -- Cek apakah tool sudah hilang dari karakter/tas
        if not petTool or not petTool.Parent or (petTool.Parent ~= character and petTool.Parent ~= LocalPlayer.Backpack) then
            isAccepted = true
            break
        end

        -- Cek via DataService apakah UUID sudah tidak ada di tas
        local curData = GetPlayerData()
        if curData and curData.PetsData and curData.PetsData.PetInventory and curData.PetsData.PetInventory.Data then
            if not curData.PetsData.PetInventory.Data[pet.UUID] then
                isAccepted = true
                break
            end
        end

        -- Cek apakah muncul pop-up peringatan "You already have a outgoing gift request for this pet!"
        if HasOutgoingGiftNotification() then
            alreadyPendingOutgoing = true
            break
        end

        task.wait(0.2)
    end

    -- Lepas pet dari tangan agar tidak nyangkut memegang pet yang sama
    humanoid:UnequipTools()

    if isAccepted then
        return true, "Diterima"
    elseif alreadyPendingOutgoing then
        return false, "Sudah ada outgoing gift request untuk pet ini"
    else
        return false, string.format("Tidak ada reaksi penerima (%.1fs)", reactionTimeout)
    end
end


