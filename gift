-- Mencari Tool berdasarkan UUID pet di Backpack atau Character
local function FindToolByUUID(uuid)
    if not uuid then return nil end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local tUuid = item:GetAttribute("PET_UUID") or item:GetAttribute("UUID") or item:GetAttribute("ITEM_UUID")
                if tUuid == uuid then
                    return item
                end
            end
        end
    end

    local character = LocalPlayer.Character
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                local tUuid = item:GetAttribute("PET_UUID") or item:GetAttribute("UUID") or item:GetAttribute("ITEM_UUID")
                if tUuid == uuid then
                    return item
                end
            end
        end
    end

    return nil
end

-- Mendapatkan semua pet yang memenuhi syarat tumbal (Dog, Bunny, Golden Lab | Age >= 75 | BW < 4)
local function GetTumbalCandidatePets()
    local data = GetPlayerData()
    if not data or not data.PetsData or not data.PetsData.PetInventory then
        return {}, {}, {}
    end

    local invData = data.PetsData.PetInventory.Data or {}
    local equipped = data.PetsData.EquippedPets or {}

    local allCandidates = {}
    local favoritedCandidates = {} -- Perlu di-unfavorite
    local readyCandidates = {}     -- Sudah unfavorite, siap dikirim

    for uuid, petObj in pairs(invData) do
        local petData = petObj.PetData or {}
        local petType = petObj.PetType or "Unknown"
        local level = tonumber(petData.Level) or 0
        local baseWeight = tonumber(petData.BaseWeight) or 0
        local isFav = (petData.IsFavorite == true)
        local isEquipped = table.find(equipped, uuid) ~= nil
        local isMutated = (petData.Mutation ~= nil and petData.Mutation ~= "")

        -- Filter: Dog, Bunny, Golden Lab
        if Config.AllowedPetTypes[petType] == true then
            -- Filter: Umur >= 75 dan Base Weight < 4kg
            if level >= Config.MinAge and baseWeight < Config.MaxBaseWeight then
                -- Proteksi: Jangan kirim pet yang sedang dipakai aktif
                if not isEquipped then
                    if not (Config.ProtectMutated and isMutated) then
                        local item = {
                            UUID = uuid,
                            PetType = petType,
                            Level = level,
                            BaseWeight = baseWeight,
                            Name = petData.Name or petType,
                            IsFavorite = isFav,
                            IsMutated = isMutated,
                            Raw = petObj
                        }

                        table.insert(allCandidates, item)
                        if isFav then
                            table.insert(favoritedCandidates, item)
                        else
                            table.insert(readyCandidates, item)
                        end
                    end
                end
            end
        end
    end

    -- Urutkan berdasarkan umur terkecil (atau base weight)
    table.sort(readyCandidates, function(a, b)
        return a.Level < b.Level
    end)

    return allCandidates, favoritedCandidates, readyCandidates
end

