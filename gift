-- Eksekusi Thread Pengiriman Pet Berantai (Target 1 -> Target 2 -> Target 3)
StartSenderBtn.MouseButton1Click:Connect(function()
    if isSenderRunning then
        isSenderRunning = false
        StartSenderBtn.Text = "MULAI AUTO KIRIM 15 PET (START)"
        StartSenderBtn.BackgroundColor3 = Color3.fromRGB(35, 140, 70)
        SenderStatusLbl.Text = "Pengiriman dihentikan oleh pengguna."
        SenderStatusLbl.TextColor3 = Color3.fromRGB(255, 140, 140)
        return
    end

    -- Validasi target accounts
    local hasAnyTarget = false
    for i = 1, 3 do
        local uName = Config.Targets[i].Username:gsub("%s+", "")
        if uName ~= "" then
            hasAnyTarget = true
            break
        end
    end

    if not hasAnyTarget then
        SenderStatusLbl.Text = "Peringatan: Masukkan minimal 1 username akun target!"
        SenderStatusLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    isSenderRunning = true
    StartSenderBtn.Text = "BERHENTIKAN PENGIRIMAN [STOP]"
    StartSenderBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)

    task.spawn(function()
        -- 1. Auto Unfavorite awal sebelum kirim jika diaktifkan
        if Config.AutoUnfavoriteOnStart then
            SenderStatusLbl.Text = "Auto Unfavorite pet tumbal yang memenuhi syarat..."
            SenderStatusLbl.TextColor3 = Color3.fromRGB(130, 215, 255)
            ExecuteUnfavoriteTumbal(true)
            task.wait(0.5)
        end

        for targetIdx = 1, 3 do
            if not isSenderRunning then break end

            local targetCfg = Config.Targets[targetIdx]
            local targetName = targetCfg.Username:gsub("%s+", "")

            if targetName ~= "" then
                currentTargetIndex = targetIdx
                local targetPlayer = FindPlayerByInput(targetName)

                if not targetPlayer then
                    SenderStatusLbl.Text = string.format("Akun %d (@%s) TIDAK DITEMUKAN di server! Melewati...", targetIdx, targetName)
                    SenderStatusLbl.TextColor3 = Color3.fromRGB(255, 120, 100)
                    targetCfg.Status = "Tidak Online"
                    task.wait(2)
                else
                    targetCfg.Status = "Sedang Dikirim"
                    SenderStatusLbl.Text = string.format("Mengirim ke Akun %d: @%s (Target: 15 Pet)...", targetIdx, targetPlayer.Name)
                    SenderStatusLbl.TextColor3 = Color3.fromRGB(100, 220, 255)

                    local petCandidateIndex = 1

                    while isSenderRunning and targetCfg.Sent < Config.TargetPetsPerAccount do
                        -- 1. Cek apakah ada pet yang sebelumnya terkirim lalu baru saja di-accept di background
                        CheckPendingPetsAccepted(targetIdx, targetCfg)
                        if targetCfg.Sent >= Config.TargetPetsPerAccount then
                            break
                        end

                        -- 2. Cari kandidat pet yang siap dikirim (sudah unfavorite)
                        local _, favoritedList, readyList = GetTumbalCandidatePets()

                        -- Jika masih ada pet yang difavoritkan, unfavorite dulu
                        if #readyList == 0 and #favoritedList > 0 then
                            SenderStatusLbl.Text = string.format("Unfavorite %d pet tumbal tambahan...", #favoritedList)
                            ExecuteUnfavoriteTumbal(true)
                            task.wait(0.5)
                            _, _, readyList = GetTumbalCandidatePets()
                        end

                        -- 3. Filter pet yang TIDAK sedang ada pending outgoing request
                        local availablePets = {}
                        local now = os.clock()
                        for _, pet in ipairs(readyList) do
                            local pending = PendingGiftPets[pet.UUID]
                            if not pending or now >= (pending.ExpireTime or 0) then
                                table.insert(availablePets, pet)
                            end
                        end

                        if #availablePets == 0 then
                            if #readyList > 0 then
                                -- Semua pet tumbal di tas sedang pending request ke target
                                SenderStatusLbl.Text = string.format("Menunggu reaksi @%s (%d pet sedang pending)...", targetPlayer.Name, #readyList)
                                SenderStatusLbl.TextColor3 = Color3.fromRGB(255, 215, 100)
                                SenderDetailLbl.Text = "Semua pet telah dikirim request. Menunggu konfirmasi penerima..."
                                task.wait(2.0)
                                CheckPendingPetsAccepted(targetIdx, targetCfg)
                            else
                                SenderStatusLbl.Text = "Stok pet tumbal habis (Dog/Bunny/Lab, Age>=75, BW<4kg)!"
                                SenderStatusLbl.TextColor3 = Color3.fromRGB(255, 120, 100)
                                isSenderRunning = false
                                break
                            end
                        else
                            -- Rotasi pemilihan pet agar selalu mengirim pet yang BERBEDA!
                            if petCandidateIndex > #availablePets then
                                petCandidateIndex = 1
                            end
                            local petToSend = availablePets[petCandidateIndex]

                            local nextPetNum = targetCfg.Sent + 1
                            -- Waktu tunggu reaksi penerima 4 - 6 detik sesuai permintaan user
                            local reactionWait = math.random(math.floor(Config.DelayMin * 10), math.floor(Config.DelayMax * 10)) / 10

                            SenderStatusLbl.Text = string.format("[Akun %d: %d/15] Request pet %s (Age %d, BW %.1f) ke @%s...", 
                                targetIdx, nextPetNum, petToSend.PetType, petToSend.Level, petToSend.BaseWeight, targetPlayer.Name)
                            SenderStatusLbl.TextColor3 = Color3.fromRGB(255, 215, 100)
                            SenderDetailLbl.Text = string.format("Menunggu respon penerima %.1f detik...", reactionWait)

                            local success, msg = SendSinglePet(targetPlayer, petToSend, reactionWait)

                            -- Cek kembali apakah ada pet pending yang diterima
                            CheckPendingPetsAccepted(targetIdx, targetCfg)

                            if success then
                                targetCfg.Sent = targetCfg.Sent + 1
                                Stats.TotalPetsSent = Stats.TotalPetsSent + 1
                                PendingGiftPets[petToSend.UUID] = nil

                                SenderStatusLbl.Text = string.format("[Akun %d: %d/15] Pet DITERIMA oleh @%s!", 
                                    targetIdx, targetCfg.Sent, targetPlayer.Name)
                                SenderStatusLbl.TextColor3 = Color3.fromRGB(100, 255, 140)

                                -- Delay antar pet 4 - 6 detik setelah diterima
                                if targetCfg.Sent < Config.TargetPetsPerAccount then
                                    local postDelay = math.random(math.floor(Config.DelayMin * 10), math.floor(Config.DelayMax * 10)) / 10
                                    SenderDetailLbl.Text = string.format("Jeda %.1fs sebelum mengambil pet ke-%d...", postDelay, targetCfg.Sent + 1)
                                    task.wait(postDelay)
                                end
                            else
                                -- Tidak ada reaksi dalam 4-6 detik ATAU ada outgoing request
                                -- Tandai pet ini di PendingGiftPets agar TIDAK diulang / spam pet yang sama!
                                PendingGiftPets[petToSend.UUID] = {
                                    TargetPlayer = targetPlayer,
                                    TargetIdx = targetIdx,
                                    SentTime = os.clock(),
                                    ExpireTime = os.clock() + 45, -- cooldown 45s
                                    Pet = petToSend
                                }

                                -- Geser ke pet BERIKUTNYA agar mengirim pet yang berbeda!
                                petCandidateIndex = petCandidateIndex + 1

                                SenderStatusLbl.Text = string.format("[%s] Beralih ke pet berbeda...", msg)
                                SenderStatusLbl.TextColor3 = Color3.fromRGB(255, 160, 80)
                                SenderDetailLbl.Text = string.format("Pet '%s' tidak direspon dalam %.1fs. Mengganti pet tumbal lain.", petToSend.Name, reactionWait)

                                task.wait(0.5)
                            end
                        end
                    end

                    if targetCfg.Sent >= Config.TargetPetsPerAccount then
                        targetCfg.Status = "Selesai (15/15)"
                        SenderStatusLbl.Text = string.format("AKUN %d (@%s) SELESAI MENERIMA 15 PET!", targetIdx, targetPlayer.Name)
                        SenderStatusLbl.TextColor3 = Color3.fromRGB(100, 255, 140)
                        task.wait(2.0)
                    end
                end
            end
        end

        isSenderRunning = false
        StartSenderBtn.Text = "MULAI AUTO KIRIM 15 PET (START)"
        StartSenderBtn.BackgroundColor3 = Color3.fromRGB(35, 140, 70)

        local allDone = true
        for i = 1, 3 do
            if Config.Targets[i].Username ~= "" and Config.Targets[i].Sent < Config.TargetPetsPerAccount then
                allDone = false
            end
        end

        if allDone then
            SenderStatusLbl.Text = "SEMUA AKUN TARGET TELAH SELESAI (15 Pet Tiap Akun)!"
            SenderStatusLbl.TextColor3 = Color3.fromRGB(100, 255, 140)
        else
            SenderStatusLbl.Text = "Proses selesai atau dihentikan."
        end
    end)
end)

local function UpdateKirimTabUI()
    for idx = 1, 3 do
        local ui = TargetCardsUI[idx]
        local cfg = Config.Targets[idx]
        if ui and cfg then
            if cfg.Username == "" then
                ui.ProgressLbl.Text = "Belum Diatur"
                ui.ProgressLbl.TextColor3 = Color3.fromRGB(130, 140, 155)
            elseif cfg.Sent >= Config.TargetPetsPerAccount then
                ui.ProgressLbl.Text = "15 / 15 (Selesai)"
                ui.ProgressLbl.TextColor3 = Color3.fromRGB(100, 255, 140)
