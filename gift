-- 6. LOGIKA FITUR 1: AUTO UNFAVOURITE PET TUMBAL
-- ========================================================================================
local function ExecuteUnfavoriteTumbal(silent)
    if not Favorite_ItemRemote then
        if not silent then
            SenderRuntime.StatusText = "Remote Favorite_Item tidak ditemukan!"
            SenderRuntime.StatusColor = Color3.fromRGB(255, 80, 80)
        end
        return 0
    end

    local _, favoritedList, _ = GetTumbalCandidatePets()
    if #favoritedList == 0 then
        if not silent then
            SenderRuntime.StatusText = "Tidak ada pet tumbal yang difavoritkan."
            SenderRuntime.StatusColor = Color3.fromRGB(140, 210, 255)
            SenderRuntime.DetailText = "Semua pet Dog, Bunny, Golden Lab (Age>=75, BW<4kg) sudah unfavorite."
        end
        return 0
    end

    local count = 0
    if not silent then
        SenderRuntime.StatusText = string.format("Memproses Unfavorite %d Pet...", #favoritedList)
        SenderRuntime.StatusColor = Color3.fromRGB(255, 200, 90)
    end

    for _, pet in ipairs(favoritedList) do
        local tool = FindToolByUUID(pet.UUID)
        if tool then
            local ok = pcall(function()
                Favorite_ItemRemote:FireServer(tool)
            end)
            if ok then
                count = count + 1
                Stats.TotalUnfavorited = Stats.TotalUnfavorited + 1
            end
            task.wait(0.1)
        end
    end

    if not silent then
        SenderRuntime.StatusText = string.format("Berhasil Unfavorite %d Pet!", count)
        SenderRuntime.StatusColor = Color3.fromRGB(100, 255, 140)
        SenderRuntime.DetailText = string.format("Unfavorite selesai. Pet siap dikirim ke target akun.")
    end

    return count
end

