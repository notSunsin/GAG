-- Helper mencari Player berdasarkan Username / DisplayName di server
local function FindPlayerByInput(targetInput)
    if not targetInput or targetInput == "" then return nil end
    local cleanInput = targetInput:gsub("^@", ""):lower()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if player.Name:lower() == cleanInput or player.DisplayName:lower() == cleanInput then
                return player
            end
        end
    end

    return nil
end

-- Deteksi banner / notifikasi di PlayerGui jika game menampilkan "You already have a outgoing gift request for this pet!"
local function HasOutgoingGiftNotification()
    if (os.clock() - LastOutgoingRequestWarning) < 2.0 then
        return true
    end

    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pgui then return false end

    for _, desc in ipairs(pgui:GetDescendants()) do
        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Visible then
            local text = desc.Text
            if text and text ~= "" and text:lower():find("outgoing gift request") then
                LastOutgoingRequestWarning = os.clock()
                return true
            end
        end
    end
    return false
end

-- Listener otomatis jika banner notifikasi baru muncul di layar
